# Puerto HTTP del servidor Fastify
PORT=3000
NODE_ENV=development

# Conexión PostgreSQL / Supabase (Pooler puerto 6543 para runtime, 5432 directo para migraciones)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Secreto JWT para firma de sesiones rápidas por PIN (reemplazar en .env local y Render)
JWT_SECRET="reemplazar-por-secreto-largo-y-seguro"

# Origen permitido por CORS (dominio del frontend en Vite o Vercel)
FRONTEND_URL="http://localhost:5173"

# Copiloto IA (usado en Milestone v0.4)
GEMINI_API_KEY=""

# Monitoreo Sentry (opcional en desarrollo, recomendado en producción)
SENTRY_DSN=""

# PINs iniciales solo para el seed de desarrollo local
SEED_CAJERO_PIN="1234"
SEED_CAJERO2_PIN="4321"
SEED_ENCARGADO_PIN="5678"
